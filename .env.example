PORT=3000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database_name

# JSON Web Token Secret for signing session tokens (must be a strong, random string)
JWT_SECRET=your_jwt_secret_here
# Token expiration time (e.g., 30d for 30 days)
JWT_EXPIRE=30d

# Mail server credentials for sending verification and password reset emails
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_ethereal_user@ethereal.email
EMAIL_PASS=your_ethereal_password

# The URL of the frontend client (for CORS configuration)
CLIENT_URL=http://localhost:3000

# Secret key required to access the admin creation script or admin endpoints
ADMIN_SECRET=your_admin_secret_phrase

# Application currency preferences
CURRENCY=GBP
CURRENCY_SYMBOL=£

# Environment (development | production)
NODE_ENV=development
