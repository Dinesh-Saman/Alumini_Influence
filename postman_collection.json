        {
            "name": "💰 Bidding",
            "item": [
                {
                    "name": "Place Bid (or Update — increase only)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.data) {",
                                    "    if (jsonData.data.currency) {",
                                    "        pm.collectionVariables.set('currency', jsonData.data.currency);",
                                    "    }",
                                    "    if (jsonData.data.currencySymbol) {",
                                    "        pm.collectionVariables.set('currencySymbol', jsonData.data.currencySymbol);",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"amount\": 250.00\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/bids",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "bids"
                            ]
                        },
                        "description": "Place a bid for tomorrow's featured slot.\n\n**Blind bidding:** Response only tells you if you are `Winning` or `Losing` — the actual highest bid amount is never revealed.\n\nIf a bid already exists for tomorrow, it can only be **increased**.\n\nResponse includes `remainingWinsThisMonth` so you know how many slots you have left."
                    },
                    "response": []
                },
                {
                    "name": "Place Bid — Invalid Amount (should fail)",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"amount\": -10\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/bids",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "bids"
                            ]
                        },
                        "description": "Should return 400 — negative bid amounts are rejected by Joi validation."
                    },
                    "response": []
                },
                {
                    "name": "Get Bid Status",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/bids/status",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "bids",
                                "status"
                            ]
                        },
                        "description": "Returns current bid status for tomorrow's slot.\n\nIncludes:\n- `bidStatus`: Winning or Losing\n- `winsThisMonth`: wins so far this month\n- `remainingWinsThisMonth`: how many more you can win\n- `bonusSlotActive`: whether you have the 4th bid slot unlocked"
                    },
                    "response": []
                },
                {
                    "name": "Get Bid History",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/bids/history",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "bids",
                                "history"
                            ]
                        },
                        "description": "Returns all past bids for the current user, most recent first.\n\nStatus values: `active`, `won`, `lost`, `cancelled`."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "🔑 Admin — API Keys",
            "item": [
                {
                    "name": "Promote User to Admin (Bootstrap)",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@eastminster.ac.uk\",\n    \"adminSecret\": \"{{adminSecret}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/promote",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "promote"
                            ]
                        },
                        "description": "**One-time bootstrap step.** Promotes an existing registered user to `admin` role.\n\n**Steps:**\n1. First register the user via `POST /api/auth/register` (or use an existing account)\n2. Run this request — no JWT needed, just the `adminSecret` from `.env`\n3. Then run `Login (Admin)` to get a JWT\n\nThe `{{adminSecret}}` variable is pre-filled in the collection variables as `bootstrap-admin-secret-2025`."
                    },
                    "response": []
                },
                {
                    "name": "Login (Admin)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.token) {",
                                    "    pm.collectionVariables.set('token', jsonData.token);",
                                    "    console.log('✅ Admin token saved to {{token}}');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@eastminster.ac.uk\",\n    \"password\": \"Admin@Pass1234\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Login with the admin account. JWT is automatically saved to `{{token}}`\n\nRun this after `Promote User to Admin`."
                    },
                    "response": []
                },
                {
                    "name": "Generate API Key",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.data && jsonData.data.key) {",
                                    "    pm.collectionVariables.set('apiKey', jsonData.data.key);",
                                    "    console.log('✅ API Key saved to collection variable {{apiKey}}');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"AR Mobile Client v1\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/apikeys",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "apikeys"
                            ]
                        },
                        "description": "**Admin only.** Generates a new API key for a client application.\n\nThe generated key is automatically saved to `{{apiKey}}` collection variable.\n\n⚠️ The key is shown only once — save it securely."
                    },
                    "response": []
                },
