                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Login with verified credentials.\n\nOn success, the JWT token is **automatically saved** to the `{{token}}` collection variable and used by all other authenticated requests."
                    },
                    "response": []
