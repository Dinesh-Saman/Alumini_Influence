                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"john.smith@eastminster.ac.uk\",\n    \"password\": \"Secure@Pass1\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        },
                        "description": "Register a new alumni account.\n\n- Email must be `.ac.uk` or `.edu` domain\n- Password: min 8 chars, uppercase, number, special character\n- A verification email is sent on success"
