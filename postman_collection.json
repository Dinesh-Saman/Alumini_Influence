{
    "info": {
        "_postman_id": "e8900000-0000-0000-0000-000000000001",
        "name": "Alumni Influencers API",
        "description": "Complete collection for testing the Alumni Influencers API.\n\n**Setup:**\n1. Set `baseUrl` collection variable to `http://localhost:3000` (default).\n2. Run **Register**, then check your email for the verification link.\n3. Run **Verify Email** with the token from the link.\n4. Run **Login** — the JWT token is automatically saved to `{{token}}`.\n5. For Client endpoints, first run **Generate API Key** (admin), then set `{{apiKey}}` in collection variables.\n\n**Password rules:** min 8 chars, at least one uppercase, one number, one special character (e.g. `Secure@Pass1`).\n**Email rules:** must be a `.ac.uk` or `.edu` university domain.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "🔐 Auth",
            "item": [
                {
