<div class="auth-wrapper">
    <div class="auth-card glass-card animate-fade-in">
        <div class="auth-header" id="authHeader">
            <div class="auth-logo">
                <i class="fa-solid fa-crown"></i>
            </div>
            <h1>Alumni Portal</h1>
            <p>Welcome back! Sign in to access your dashboard</p>
        </div>
        
        <% if (error) { %>
            <div class="alert alert-error" style="margin-bottom: 0.75rem; padding: 0.6rem 1rem;">
                <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
            </div>
        <% } %>

        <form action="/portal/login" method="POST" class="auth-form">
            <div class="form-group mb-4">
                <label><i class="fa-solid fa-envelope"></i> Email Address</label>
                <input type="email" name="email" required placeholder="alumni@university.ac.uk" class="glass-input">
            </div>
            <div class="form-group mb-4">
                <label><i class="fa-solid fa-lock"></i> Password</label>
                <input type="password" name="password" required placeholder="••••••••" class="glass-input">
            </div>
            
            <button type="submit" class="btn-primary auth-btn">
                <span>Sign In</span>
                <i class="fa-solid fa-arrow-right-to-bracket"></i>
            </button>
        </form>

        <div class="auth-footer">
            <p>Alumni Network</p>
            <div class="auth-links" style="display: flex; flex-direction: column; gap: 0.5rem;">
                <div>
                    New here? <a href="/portal/register">Create Account</a>
                </div>
                <div>
                    Forgotten your password? <a href="/portal/forgot-password">Reset it</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.auth-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: radial-gradient(circle at top right, rgba(245, 158, 11, 0.1), transparent),
                radial-gradient(circle at bottom left, rgba(217, 119, 6, 0.1), transparent);
}

.auth-card {
    width: 100%;
    max-width: 420px;
    padding: 1.5rem 2rem !important;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.auth-header { margin-bottom: 1.25rem; transition: all 0.3s ease; }

.auth-logo {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #f59e0b, #d97706); /* Amber branding */
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    font-size: 1.5rem;
    color: #fff;
    box-shadow: 0 10px 20px rgba(245, 158, 11, 0.3);
}

.auth-header h1 {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 0.15rem;
    letter-spacing: -0.5px;
}

.auth-header p {
    color: var(--text-muted);
    font-size: 0.85rem;
}

.glass-input {
    background: rgba(15, 23, 42, 0.4) !important;
    border: 1px solid var(--glass-border) !important;
    color: #fff !important;
    padding: 0.75rem 1rem !important;
    border-radius: 8px !important;
    width: 100%;
    transition: all 0.3s ease !important;
}

.glass-input:focus {
    border-color: #f59e0b !important;
    box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.15) !important;
    background: rgba(15, 23, 42, 0.6) !important;
}

.btn-primary.auth-btn {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    border: none;
    width: 100%;
    padding: 0.8rem !important;
    font-size: 0.95rem !important;
    margin-top: 0.25rem;
    justify-content: center;
    display: flex;
    align-items: center;
    gap: 10px;
    color: white;
    border-radius: 8px;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.btn-primary.auth-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(245, 158, 11, 0.4);
}

.auth-footer {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--glass-border);
}

.auth-footer p {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
}

.auth-links {
    font-size: 0.95rem;
    color: var(--text-muted);
}

.auth-links a {
    color: #f59e0b;
    text-decoration: none;
    font-weight: 600;
    margin-left: 5px;
}

.auth-links a:hover {
    text-decoration: underline;
}

.alert {
    border-radius: 12px;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 10px;
    text-align: left;
}

.alert-error {
    background: rgba(244, 63, 94, 0.1);
    border: 1px solid rgba(244, 63, 94, 0.2);
    color: #f43f5e;
}

.animate-fade-in { animation: fadeIn 0.5s ease-out; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
