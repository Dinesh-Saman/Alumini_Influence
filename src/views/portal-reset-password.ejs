<div class="auth-wrapper">
    <div class="auth-card glass-card animate-fade-in">
        <div class="auth-header">
            <div class="auth-logo" style="background: linear-gradient(135deg, #10b981, #059669); box-shadow: 0 10px 20px rgba(16, 185, 129, 0.3);">
                <i class="fa-solid fa-lock-open"></i>
            </div>
            <h1>Set New Password</h1>
            <p>Choose a strong, secure new password for your account.</p>
        </div>

        <div id="alertBox"></div>

        <form id="resetForm" class="auth-form">
            <div class="form-group mb-4">
                <label><i class="fa-solid fa-lock"></i> New Password</label>
                <input type="password" id="passwordInput" required placeholder="••••••••" class="glass-input">
                <p style="font-size: 0.75rem; color: #64748b; margin-top: 0.5rem; text-align: left;">Must be 8+ chars with uppercase, number & special character.</p>
            </div>
            <div class="form-group mb-4">
                <label><i class="fa-solid fa-lock"></i> Confirm Password</label>
                <input type="password" id="confirmInput" required placeholder="••••••••" class="glass-input">
            </div>
            <button type="submit" id="submitBtn" class="btn-primary auth-btn" style="background: linear-gradient(135deg, #10b981, #059669);">
                <span>Reset Password</span>
                <i class="fa-solid fa-check"></i>
            </button>
        </form>

        <div class="auth-footer">
            <p>Alumni Network</p>
            <div class="auth-links">
                <div>Remembered it? <a href="/portal/login">Back to Login</a></div>
            </div>
        </div>
    </div>
</div>

<style>
.auth-wrapper { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; background: radial-gradient(circle at top right, rgba(16, 185, 129, 0.1), transparent), radial-gradient(circle at bottom left, rgba(5, 150, 105, 0.1), transparent); }
.auth-card { width: 100%; max-width: 420px; padding: 1.5rem 2rem !important; text-align: center; border: 1px solid rgba(255, 255, 255, 0.1); }
.auth-logo { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 1.5rem; color: #fff; }
.auth-header h1 { font-size: 1.5rem; font-weight: 800; margin-bottom: 0.15rem; letter-spacing: -0.5px; }
.auth-header p { color: var(--text-muted); font-size: 0.85rem; }
.auth-header { margin-bottom: 1.25rem; }
.glass-input { background: rgba(15, 23, 42, 0.4) !important; border: 1px solid var(--glass-border) !important; color: #fff !important; padding: 0.75rem 1rem !important; border-radius: 8px !important; width: 100%; transition: all 0.3s ease !important; }
.glass-input:focus { border-color: #10b981 !important; box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15) !important; background: rgba(15, 23, 42, 0.6) !important; }
.btn-primary.auth-btn { border: none; width: 100%; padding: 0.8rem !important; font-size: 0.95rem !important; margin-top: 0.25rem; justify-content: center; display: flex; align-items: center; gap: 10px; color: white; border-radius: 8px; cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease; }
.btn-primary.auth-btn:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(16, 185, 129, 0.4); }
.auth-footer { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--glass-border); }
.auth-footer p { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 2px; color: var(--text-muted); margin-bottom: 0.5rem; }
.auth-links { font-size: 0.95rem; color: var(--text-muted); }
.auth-links a { color: #10b981; text-decoration: none; font-weight: 600; margin-left: 5px; }
.auth-links a:hover { text-decoration: underline; }
.animate-fade-in { animation: fadeIn 0.5s ease-out; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
const token = window.location.pathname.split('/').pop();

document.getElementById('resetForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submitBtn');
    const alertBox = document.getElementById('alertBox');
    const password = document.getElementById('passwordInput').value;
    const confirm = document.getElementById('confirmInput').value;

    if (password !== confirm) {
        alertBox.innerHTML = `<div style="background: rgba(244,63,94,0.1); color: #f43f5e; border: 1px solid rgba(244,63,94,0.2); padding: 1rem; border-radius: 8px; margin-bottom: 1rem;"><i class="fa-solid fa-circle-exclamation"></i> Passwords do not match.</div>`;
        return;
    }

    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Resetting...';
    alertBox.innerHTML = '';

    try {
        const res = await fetch(`/api/auth/resetpassword/${token}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password })
        });
        const data = await res.json();

        if (data.success) {
            alertBox.innerHTML = `<div style="background: rgba(16,185,129,0.1); color: #10b981; border: 1px solid rgba(16,185,129,0.2); padding: 1rem; border-radius: 8px; margin-bottom: 1rem;"><i class="fa-solid fa-check-circle"></i> Password reset successfully! Redirecting to login...</div>`;
            document.getElementById('resetForm').style.display = 'none';
            setTimeout(() => window.location.href = '/portal/login', 2500);
        } else {
            alertBox.innerHTML = `<div style="background: rgba(244,63,94,0.1); color: #f43f5e; border: 1px solid rgba(244,63,94,0.2); padding: 1rem; border-radius: 8px; margin-bottom: 1rem;"><i class="fa-solid fa-circle-exclamation"></i> ${data.message}</div>`;
            btn.disabled = false;
            btn.innerHTML = '<span>Reset Password</span><i class="fa-solid fa-check"></i>';
        }
    } catch(err) {
        alertBox.innerHTML = `<div style="background: rgba(244,63,94,0.1); color: #f43f5e; border: 1px solid rgba(244,63,94,0.2); padding: 1rem; border-radius: 8px; margin-bottom: 1rem;"><i class="fa-solid fa-triangle-exclamation"></i> Network error. Try again.</div>`;
        btn.disabled = false;
        btn.innerHTML = '<span>Reset Password</span><i class="fa-solid fa-check"></i>';
    }
});
</script>
