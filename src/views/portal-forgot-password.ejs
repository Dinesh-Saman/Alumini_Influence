<div class="auth-wrapper">
    <div class="auth-card glass-card animate-fade-in">
        <div class="auth-header">
            <div class="auth-logo" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9); box-shadow: 0 10px 20px rgba(139, 92, 246, 0.3);">
                <i class="fa-solid fa-key"></i>
            </div>
            <h1>Reset Password</h1>
            <p>Enter your university email and we'll send a reset link.</p>
        </div>

        <div id="alertBox"></div>

        <form id="forgotForm" class="auth-form">
            <div class="form-group mb-4">
                <label><i class="fa-solid fa-envelope"></i> University Email</label>
                <input type="email" id="emailInput" required placeholder="alumni@university.ac.uk" class="glass-input">
            </div>
            <button type="submit" id="submitBtn" class="btn-primary auth-btn" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9);">
                <span>Send Reset Link</span>
                <i class="fa-solid fa-paper-plane"></i>
            </button>
        </form>

        <div class="auth-footer">
            <p>Alumni Network</p>
            <div class="auth-links">
                <div>Remembered it? <a href="/portal/login">Back to Login</a></div>
            </div>
        </div>
    </div>
</div>

<style>
.auth-wrapper { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; background: radial-gradient(circle at top right, rgba(139, 92, 246, 0.1), transparent), radial-gradient(circle at bottom left, rgba(109, 40, 217, 0.1), transparent); }
.auth-card { width: 100%; max-width: 420px; padding: 1.5rem 2rem !important; text-align: center; border: 1px solid rgba(255, 255, 255, 0.1); }
.auth-logo { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 1.5rem; color: #fff; }
.auth-header h1 { font-size: 1.5rem; font-weight: 800; margin-bottom: 0.15rem; letter-spacing: -0.5px; }
.auth-header p { color: var(--text-muted); font-size: 0.85rem; }
.auth-header { margin-bottom: 1.25rem; }
.glass-input { background: rgba(15, 23, 42, 0.4) !important; border: 1px solid var(--glass-border) !important; color: #fff !important; padding: 0.75rem 1rem !important; border-radius: 8px !important; width: 100%; transition: all 0.3s ease !important; }
.glass-input:focus { border-color: #8b5cf6 !important; box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.15) !important; background: rgba(15, 23, 42, 0.6) !important; }
.btn-primary.auth-btn { border: none; width: 100%; padding: 0.8rem !important; font-size: 0.95rem !important; margin-top: 0.25rem; justify-content: center; display: flex; align-items: center; gap: 10px; color: white; border-radius: 8px; cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease; }
.btn-primary.auth-btn:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(139, 92, 246, 0.4); }
.auth-footer { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--glass-border); }
.auth-footer p { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 2px; color: var(--text-muted); margin-bottom: 0.5rem; }
.auth-links { font-size: 0.95rem; color: var(--text-muted); }
.auth-links a { color: #8b5cf6; text-decoration: none; font-weight: 600; margin-left: 5px; }
.auth-links a:hover { text-decoration: underline; }
.animate-fade-in { animation: fadeIn 0.5s ease-out; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
document.getElementById('forgotForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submitBtn');
    const alertBox = document.getElementById('alertBox');
    const email = document.getElementById('emailInput').value.trim();

    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';
    alertBox.innerHTML = '';

    try {
        const res = await fetch('/api/auth/forgotpassword', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email })
        });
        const data = await res.json();

        if (data.success) {
            alertBox.innerHTML = `<div style="background: rgba(16,185,129,0.1); color: #10b981; border: 1px solid rgba(16,185,129,0.2); padding: 1rem; border-radius: 8px; margin-bottom: 1rem;"><i class="fa-solid fa-check-circle"></i> Reset link sent! Check your inbox.</div>`;
            document.getElementById('forgotForm').style.display = 'none';
        } else {
            alertBox.innerHTML = `<div style="background: rgba(244,63,94,0.1); color: #f43f5e; border: 1px solid rgba(244,63,94,0.2); padding: 1rem; border-radius: 8px; margin-bottom: 1rem;"><i class="fa-solid fa-circle-exclamation"></i> ${data.message}</div>`;
            btn.disabled = false;
            btn.innerHTML = '<span>Send Reset Link</span><i class="fa-solid fa-paper-plane"></i>';
        }
    } catch(err) {
        alertBox.innerHTML = `<div style="background: rgba(244,63,94,0.1); color: #f43f5e; border: 1px solid rgba(244,63,94,0.2); padding: 1rem; border-radius: 8px; margin-bottom: 1rem;"><i class="fa-solid fa-triangle-exclamation"></i> Network error. Try again.</div>`;
        btn.disabled = false;
        btn.innerHTML = '<span>Send Reset Link</span><i class="fa-solid fa-paper-plane"></i>';
    }
});
</script>
